{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jsA8E",
  "version": "0.1.0",
  "identifier": "com.a8e.jsa8e",
  "build": {
    "frontendDist": "../jsA8E",
    "devUrl": "http://127.0.0.1:8090/jsA8E/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "jsA8E - Atari 800 XL Emulator",
        "dragDropEnabled": true,
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "shortDescription": "Atari 800 XL emulator",
    "longDescription": "A8E Atari 800 XL emulator with PAL/NTSC and expanded memory support"
  }
}
