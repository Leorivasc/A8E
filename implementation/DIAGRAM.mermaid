classDef toneNeutral fill:#f8fafc,stroke:#334155,stroke-width:1.5px,color:#0f172a
classDef toneBlue fill:#dbeafe,stroke:#2563eb,stroke-width:1.5px,color:#172554
classDef toneAmber fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#78350f
classDef toneMint fill:#dcfce7,stroke:#16a34a,stroke-width:1.5px,color:#14532d
classDef toneRose fill:#ffe4e6,stroke:#e11d48,stroke-width:1.5px,color:#881337
classDef toneIndigo fill:#e0e7ff,stroke:#4f46e5,stroke-width:1.5px,color:#312e81
classDef toneTeal fill:#ccfbf1,stroke:#0f766e,stroke-width:1.5px,color:#134e4a
class node_ui,node_app,node_proxy,node_automation,node_worker,node_user toneBlue
class node_machine_js,node_cpu,node_memory,node_io,node_antic,node_gtia,node_pokey,node_pia,node_playfield toneAmber
class node_disk,node_library_pkg,node_hostfs,node_snapshot,node_debugger,node_assembler,node_artifacts toneMint
class node_gl,node_software,node_audio,node_worklet toneRose
class node_native_app,node_native_cpu,node_native_io,node_native_antic,node_native_gtia,node_native_pokey,node_native_pia,node_native_library toneIndigo
class node_guest_tests,node_js_tests,node_validation_doc toneTeal
class node_native_tests toneRose
